<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Asset"
        android:textColor="@color/accent"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/detailsSymbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="NVDA"
        android:textColor="@color/textPrimary"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/detailsName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="NVIDIA Corporation"
        android:textColor="@color/textSecondary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/detailsPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="$120.50"
        android:textColor="@color/textPrimary"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/detailsChange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="+2.11%"
        android:textColor="@color/positive"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/detailsPeriod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Zum vorherigen Handelsschluss"
        android:textColor="@color/textSecondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/detailsMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Datenstand: –"
        android:textColor="@color/textSecondary"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWatchlistToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:backgroundTint="@color/surface2"
        app:cornerRadius="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:text="Zur Watchlist hinzufügen"
        android:textAllCaps="false"
        android:textColor="@color/accent"
        android:textSize="16sp" />

</LinearLayout>
